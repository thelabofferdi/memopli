# Les noms et valeurs par défaut reprennent backend/app/config.py (un test le vérifie).

# API RodiumAi (compatible OpenAI) — la clé ne va jamais dans le dépôt
RODIUM_BASE_URL=https://api.rodiumai.io/v1
RODIUM_API_KEY=
AI_TIMEOUT=120
# Coût estimé en FCFA pour 1000 tokens
COST_IN=1.2
COST_OUT=6

# Modèles (noms exacts de GET /v1/models)
MODEL_EXTRACT=anthropic/claude-haiku-4-5-20251001
MODEL_MATCH=google/gemini-3.5-flash-lite
MODEL_DRAFT=anthropic/claude-haiku-4-5-20251001
MODEL_CHAT=google/gemini-3.5-flash
MODEL_OCR=google/gemini-3.5-flash

# Application
DATABASE_PATH=data/app.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=20
MAX_PAGES=400
MAX_CHARS=2000000

# OCR local (tesseract) et recherche documentaire (BM25)
OCR_VISION=false
OCR_LANGS=fra
OCR_MAX_PAGES=10
RAG_CHUNK_CHARS=1200
RAG_K=6

# HTTP : origines du front et hôtes acceptés (séparés par des virgules)
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Sécurité
# AUTH_REQUIRED=false laisse l'API ouverte (démonstration) ; true exige un jeton
AUTH_REQUIRED=false
SESSION_DAYS=30
RATE_LIMIT=true
RATE_AI_PER_HOUR=60
RATE_UPLOAD_PER_HOUR=60
RATE_AUTH_PER_MINUTE=10
# true seulement derrière un reverse proxy de confiance (lit X-Forwarded-For)
TRUST_PROXY=false
# /docs et /openapi.json : à couper en production
DOCS_ENABLED=false

# dev | prod — en prod, AUTH_REQUIRED=true obligatoire, sinon refus de démarrer
APP_ENV=dev
