# API RodiumAi (compatible OpenAI)
RODIUM_BASE_URL=https://api.rodiumai.io/v1
RODIUM_API_KEY=

# Modèles
MODEL_EXTRACT=claude-haiku-4-5
MODEL_MATCH=gemini-3-5-flash-lite
MODEL_DRAFT=claude-haiku-4-5

# Application
DATABASE_PATH=data/app.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=20
MAX_PAGES=400
MAX_CHARS=2000000

# HTTP : origines du front et hôtes acceptés (séparés par des virgules)
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
ALLOWED_HOSTS=127.0.0.1,localhost

# Sécurité
# AUTH_REQUIRED=false laisse l'API ouverte (démonstration) ; true exige un jeton
AUTH_REQUIRED=false
SESSION_DAYS=30
RATE_LIMIT=true
RATE_AI_PER_HOUR=60
RATE_UPLOAD_PER_HOUR=60
RATE_AUTH_PER_MINUTE=10
# true derrière un reverse proxy (Caddy) pour lire X-Forwarded-For
TRUST_PROXY=false
# /docs et /openapi.json : à couper en production
DOCS_ENABLED=false

# dev | prod — en prod, AUTH_REQUIRED=true obligatoire, sinon refus de démarrer
APP_ENV=dev
